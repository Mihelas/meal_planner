node_modules/

# Build output. Regenerated by `npm run build` from src/, so committing it would
# mean reviewing a 450 kB diff on every change and resolving conflicts in a file
# nobody edits. The deploy builds it instead.
dist/

# Working notes, kept on disk and out of the repo. These are the running tracker
# and a cross-project lessons file -- notes to ourselves about how the work is
# going, not documentation of the app. The repo is public, so they do not belong
# in it. README.md is the published account of the project.
tasks/

# Local scratch and editor noise.
*.tmp
*.log
.DS_Store
Thumbs.db

# Two stray files a mistyped shell command left behind. Left on disk rather than
# deleted so nobody wonders where they went; they hold a carriage return and `[]`.
/-c
/-c.json
